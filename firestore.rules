rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS FOR SINGLE SCHOOL ARCHITECTURE ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().status == 'ACTIVE';
    }

    function isSchoolAdmin() {
      return isTeacher() && getUserData().role == 'SCHOOL_ADMIN';
    }

    function isTeamLeader() {
      return isTeacher() && getUserData().role == 'TEAM_LEADER';
    }

    function isOwner(teacherId) {
      return isTeacher() && request.auth.uid == teacherId;
    }

    function canManageClass(classId) {
      let classData = get(/databases/$(database)/documents/classes/$(classId)).data;
      return isSchoolAdmin()
        || request.auth.uid == classData.teacherId
        || (classData.coTeacherIds != null && classData.coTeacherIds.hasAny([request.auth.uid]));
    }

    function canManageQuiz(quizId) {
      let quizData = get(/databases/$(database)/documents/quizzes/$(quizId)).data;
      return isSchoolAdmin() || request.auth.uid == quizData.teacherId;
    }

    function canManageRoom(roomId) {
      let roomData = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSchoolAdmin() || (isTeacher() && request.auth.uid == roomData.teacherId);
    }

    function isSameTeam(teamIds) {
      return isTeacher() && getUserData().teamIds.hasAny(teamIds);
    }

    // 1. Single School User Profiles (users/{uid})
    match /users/{uid} {
      allow read: if isTeacher() || (
        isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == uid
      );

      // One-time bootstrap for the school's original administrator.
      // The authenticated Google/Email identity must own the exact configured admin email.
      allow create: if isSchoolAdmin() || (
        isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == uid
        && request.auth.token.email == 'tranlichsu@gmail.com'
        && request.resource.data.uid == uid
        && request.resource.data.email == 'tranlichsu@gmail.com'
        && request.resource.data.role == 'SCHOOL_ADMIN'
        && request.resource.data.status == 'ACTIVE'
      );

      allow update, delete: if isSchoolAdmin();
    }

    // 2. Single School Settings (settings/school)
    match /settings/school {
      allow read: if isAuthenticated();
      allow write: if isSchoolAdmin();
    }

    // 3. Single School Teams (teams/{teamId})
    match /teams/{teamId} {
      allow read: if isTeacher();
      allow write: if isSchoolAdmin();
    }

    // 4. Single School Join Requests (joinRequests/{requestId})
    match /joinRequests/{requestId} {
      allow read: if isSchoolAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSchoolAdmin();
    }

    // 5. Single School Audit Logs (auditLogs/{logId})
    match /auditLogs/{logId} {
      allow read: if isSchoolAdmin();
      allow create: if isSchoolAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // 6. Classes (classes/{classId})
    match /classes/{classId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update, delete: if canManageClass(classId);

      match /students/{studentId} {
        allow read: if isTeacher();
        allow write: if canManageClass(classId);
      }
    }

    // 7. Quizzes (quizzes/{quizId})
    match /quizzes/{quizId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update, delete: if canManageQuiz(quizId);

      match /questions/{questionId} {
        allow read: if isTeacher();
        allow create, update, delete: if canManageQuiz(quizId);
      }
    }

    // Personal reusable questions: teacher-only, scoped to the owner.
    match /questionBank/{questionId} {
      allow read, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
    }

    // 8. Public room-code lookup (direct get only; list/query is denied)
    match /roomCodes/{roomCode} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isSchoolAdmin() || (
        isTeacher() && resource.data.teacherId == request.auth.uid
      );
    }

    // 8. Rooms (rooms/{roomId})
    match /rooms/{roomId} {
      allow read: if (
        isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
      ) || canManageRoom(roomId);
      allow create: if isTeacher();
      allow update: if canManageRoom(roomId) || (
        isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantCount', 'lastParticipantId'])
        && request.resource.data.participantCount == resource.data.get('participantCount', 0) + 1
        && request.resource.data.lastParticipantId is string
        && !exists(
          /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.lastParticipantId)
        )
        && existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.lastParticipantId)
        )
        && getAfter(
          /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.lastParticipantId)
        ).data.mockAuthUid == request.auth.uid
      );
      allow delete: if canManageRoom(roomId);

      match /roster/{studentId} {
        allow read: if isAuthenticated();
        allow write: if canManageRoom(roomId);
      }

      match /participants/{studentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/roster/$(studentId))
          && request.resource.data.studentId == studentId
          && request.resource.data.mockAuthUid == request.auth.uid;
        allow update: if canManageRoom(roomId) || (
          isAuthenticated()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/roster/$(studentId))
          && resource.data.mockAuthUid == request.auth.uid
          && request.resource.data.studentId == studentId
          && request.resource.data.mockAuthUid == request.auth.uid
        );
        allow delete: if canManageRoom(roomId);
      }

      match /liveQuestions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if canManageRoom(roomId);
      }

      match /submissions/{submissionId} {
        allow read: if isTeacher() || (
          isAuthenticated()
          && resource.data.authUid == request.auth.uid
        );
        allow create: if isAuthenticated()
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.questionId is string
          && request.resource.data.studentId is string
          && get(
            /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.studentId)
          ).data.mockAuthUid == request.auth.uid
          && request.resource.data.studentName == get(
            /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.studentId)
          ).data.name
          && get(
            /databases/$(database)/documents/rooms/$(roomId)/liveQuestions/$(request.resource.data.questionId)
          ).data.status == 'OPEN';
        allow update, delete: if canManageRoom(roomId);
      }

      match /scores/{studentId} {
        allow read: if canManageRoom(roomId) || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && get(
            /databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)
          ).data.mockAuthUid == request.auth.uid
        );
        allow write: if canManageRoom(roomId);
      }

      match /scoreEvents/{eventId} {
        allow read: if isTeacher();
        allow write: if canManageRoom(roomId);
      }

      match /summary/{summaryId} {
        allow read: if isTeacher();
        allow write: if canManageRoom(roomId);
      }

      match /games/{gameId} {
        allow read: if isAuthenticated();
        allow write: if canManageRoom(roomId);
      }
    }

    match /traditionMaterials/{materialId} {
      allow read: if resource.data.published == true || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.kind in ['HISTORY','CULTURE','IMAGE','VIDEO'];
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.published == true
        && request.resource.data.kind in ['HISTORY','CULTURE','IMAGE','VIDEO'];
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /traditionQuizzes/{quizId} {
      allow read: if resource.data.published == true || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.published == true && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 200;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.published == true && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 200;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Public learning copies, isolated from pupil identities and private assessment records.
    match /selfPracticeQuizzes/{quizId} {
      function validLearningCopy() {
        return request.resource.data.keys().hasOnly(['id','teacherId','title','grade','subject','questions','published','updatedAt'])
          && request.resource.data.id == quizId
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.published == true
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.grade is string && request.resource.data.subject is string
          && request.resource.data.questions is list
          && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 200;
      }
      allow read: if resource.data.published == true || isOwner(resource.data.teacherId);
      allow create: if isTeacher() && validLearningCopy();
      allow update: if isOwner(resource.data.teacherId) && validLearningCopy()
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if isOwner(resource.data.teacherId);
    }

    match /testCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if code.matches('[0-9]{6}') && isTeacher()
        && (isSchoolAdmin() || request.resource.data.teacherId == request.auth.uid)
        && get(/databases/$(database)/documents/practiceSets/$(request.resource.data.testId)).data.type == 'TEST'
        && get(/databases/$(database)/documents/practiceSets/$(request.resource.data.testId)).data.teacherId == request.resource.data.teacherId;
      allow update: if false;
      allow delete: if isSchoolAdmin() || isOwner(resource.data.teacherId);
    }

    // 9. Self-Paced Practice Sets (practiceSets/{setId})
    match /practiceSets/{setId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update, delete: if isSchoolAdmin() || isOwner(resource.data.teacherId);

      match /studentProgress/{studentId} {
        allow read: if isTeacher() || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && (
            resource.data.authUid == null
            || resource.data.authUid == request.auth.uid
          )
        );
        allow create: if isTeacher();
        allow update: if isTeacher() || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && (
            resource.data.authUid == request.auth.uid
            || (
              resource.data.authUid == null
              && request.resource.data.authUid == request.auth.uid
            )
          )
        );
        allow delete: if isTeacher();
      }

      match /responses/{responseId} {
        allow read: if isTeacher() || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.authUid == request.auth.uid
        );
        allow create: if isAuthenticated()
          && request.resource.data.authUid == request.auth.uid;
        allow update: if isTeacher() || (
          isAuthenticated()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == request.auth.uid
        );
        allow delete: if isTeacher() || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.authUid == request.auth.uid
        );
      }
    }

    // 10. History Summaries (history/{historyId})
    match /history/{historyId} {
      allow read: if isSchoolAdmin() || isTeacher();
      allow write: if isTeacher();
    }

    // 11. Feedback
    match /pilotFeedback/{feedbackId} {
      allow read: if isSchoolAdmin();
      allow create: if isAuthenticated();
    }
  }
}
