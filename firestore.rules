rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS FOR SINGLE SCHOOL ARCHITECTURE ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().status == 'ACTIVE';
    }

    function isSchoolAdmin() {
      return isTeacher() && getUserData().role == 'SCHOOL_ADMIN';
    }

    function isTeamLeader() {
      return isTeacher() && getUserData().role == 'TEAM_LEADER';
    }

    function isOwner(teacherId) {
      return isTeacher() && request.auth.uid == teacherId;
    }

    function canManageClass(classId) {
      let classData = get(/databases/$(database)/documents/classes/$(classId)).data;
      return isSchoolAdmin()
        || request.auth.uid == classData.teacherId
        || (classData.coTeacherIds != null && classData.coTeacherIds.hasAny([request.auth.uid]));
    }

    function canManageQuiz(quizId) {
      let quizData = get(/databases/$(database)/documents/quizzes/$(quizId)).data;
      return isSchoolAdmin() || request.auth.uid == quizData.teacherId;
    }

    function canManageRoom(roomId) {
      let roomData = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSchoolAdmin() || (isTeacher() && request.auth.uid == roomData.teacherId);
    }

    function isSameTeam(teamIds) {
      return isTeacher() && getUserData().teamIds.hasAny(teamIds);
    }

    // 1. Single School User Profiles (users/{uid})
    match /users/{uid} {
      allow read: if isTeacher() || (
        isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == uid
      );

      // One-time bootstrap for the school's original administrator.
      // The authenticated Google/Email identity must own the exact configured admin email.
      allow create: if isSchoolAdmin() || (
        isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == uid
        && request.auth.token.email == 'tranlichsu@gmail.com'
        && request.resource.data.uid == uid
        && request.resource.data.email == 'tranlichsu@gmail.com'
        && request.resource.data.role == 'SCHOOL_ADMIN'
        && request.resource.data.status == 'ACTIVE'
      );

      allow update, delete: if isSchoolAdmin();
    }

    // 2. Single School Settings (settings/school)
    match /settings/school {
      allow read: if isAuthenticated();
      allow write: if isSchoolAdmin();
    }

    // 3. Single School Teams (teams/{teamId})
    match /teams/{teamId} {
      allow read: if isTeacher();
      allow write: if isSchoolAdmin();
    }

    // 4. Single School Join Requests (joinRequests/{requestId})
    match /joinRequests/{requestId} {
      allow read: if isSchoolAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSchoolAdmin();
    }

    // 5. Single School Audit Logs (auditLogs/{logId})
    match /auditLogs/{logId} {
      allow read: if isSchoolAdmin();
      allow create: if isSchoolAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // 6. Classes (classes/{classId})
    match /classes/{classId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update, delete: if canManageClass(classId);

      match /students/{studentId} {
        allow read: if isTeacher();
        allow write: if canManageClass(classId);
      }
    }

    // 7. Quizzes (quizzes/{quizId})
    match /quizzes/{quizId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update, delete: if canManageQuiz(quizId);

      match /questions/{questionId} {
        allow read: if isTeacher();
        allow create: if canManageQuiz(quizId) || (
          isTeacher()
          && existsAfter(/databases/$(database)/documents/quizzes/$(quizId))
          && getAfter(/databases/$(database)/documents/quizzes/$(quizId)).data.teacherId == request.auth.uid
        );
        allow update, delete: if canManageQuiz(quizId);
      }
    }

    // Personal reusable questions: teacher-only, scoped to the owner.
    match /questionBank/{questionId} {
      allow read, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
    }

    // 8. Public room-code lookup (direct get only; list/query is denied)
    match /roomCodes/{roomCode} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isSchoolAdmin() || (
        isTeacher() && resource.data.teacherId == request.auth.uid
      );
    }

    // 8. Rooms (rooms/{roomId})
    match /rooms/{roomId} {
      allow read: if (
        isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
      ) || canManageRoom(roomId);
      allow create: if isTeacher();
      allow update: if canManageRoom(roomId) || (
        isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantCount', 'lastParticipantId'])
        && request.resource.data.participantCount == resource.data.get('participantCount', 0) + 1
        && request.resource.data.lastParticipantId is string
        && !exists(
          /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.lastParticipantId)
        )
        && existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.lastParticipantId)
        )
        && getAfter(
          /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.lastParticipantId)
        ).data.mockAuthUid == request.auth.uid
      );
      allow delete: if canManageRoom(roomId);

      match /encouragements/{studentId} {
        function validBadge(badge) {
          return badge is map && badge.keys().hasOnly(['id','reason','awardedAt']) && badge.keys().hasAll(['id','reason','awardedAt'])
            && badge.id is string && badge.id.size() > 0 && badge.id.size() <= 100
            && badge.reason is string && badge.reason.size() > 0 && badge.reason.size() <= 300
            && badge.awardedAt is string && badge.awardedAt.size() <= 40;
        }
        function validEncouragement() {
          let d = request.resource.data;
          let p = get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)).data;
          return d.keys().hasOnly(['studentId','studentName','teacherId','updatedAt','badges'])
            && d.studentId == studentId && d.studentName == p.name
            && d.teacherId == get(/databases/$(database)/documents/rooms/$(roomId)).data.teacherId
            && d.updatedAt is string && d.updatedAt.size() <= 40 && d.badges is map
            && d.badges.keys().hasOnly(['EFFORT','PROGRESS','TEAMWORK','KINDNESS','DILIGENCE','COURAGE'])
            && (!('EFFORT' in d.badges) || validBadge(d.badges.EFFORT))
            && (!('PROGRESS' in d.badges) || validBadge(d.badges.PROGRESS))
            && (!('TEAMWORK' in d.badges) || validBadge(d.badges.TEAMWORK))
            && (!('KINDNESS' in d.badges) || validBadge(d.badges.KINDNESS))
            && (!('DILIGENCE' in d.badges) || validBadge(d.badges.DILIGENCE))
            && (!('COURAGE' in d.badges) || validBadge(d.badges.COURAGE));
        }
        allow get: if canManageRoom(roomId) || (isAuthenticated() && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)).data.mockAuthUid == request.auth.uid);
        allow list: if canManageRoom(roomId);
        allow create, update: if canManageRoom(roomId) && validEncouragement();
        allow delete: if false;
      }
      match /learningSignals/{studentId} {
        function ownsSignal() {
          return isAuthenticated() && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)).data.mockAuthUid == request.auth.uid;
        }
        function validStudentSignal() {
          let d = request.resource.data;
          return ownsSignal()
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'FINISHED'
            && d.keys().hasOnly(['studentId','studentName','authUid','level','handled','updatedAt','requestId'])
            && d.studentId == studentId && d.authUid == request.auth.uid
            && d.studentName == get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)).data.name
            && d.level in ['UNDERSTOOD','UNSURE','HELP'] && d.handled == false && d.updatedAt is string && d.requestId is string && d.requestId.size() > 0 && d.requestId.size() <= 100;
        }
        allow get: if canManageRoom(roomId) || ownsSignal();
        allow list: if canManageRoom(roomId);
        allow create: if validStudentSignal();
        allow update: if validStudentSignal() || (canManageRoom(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled'])
          && request.resource.data.handled == true);
        allow delete: if false;
      }

      match /worksheetState/{stateId} {
        function validWorksheetState() {
          let s = request.resource.data;
          return stateId == 'current'
            && s.keys().hasOnly(['worksheetId','projectedStudentId','projectedWorksheetId','showStudentName'])
            && s.showStudentName is bool
            && (s.worksheetId == null || (s.worksheetId is string
              && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(s.worksheetId))))
            && (s.projectedWorksheetId == null || (s.projectedWorksheetId is string
              && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(s.projectedWorksheetId))))
            && (s.projectedStudentId == null || (s.projectedStudentId is string && s.projectedWorksheetId is string
              && exists(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(s.projectedWorksheetId)/responses/$(s.projectedStudentId))));
        }
        allow read: if isAuthenticated();
        allow create, update: if canManageRoom(roomId) && validWorksheetState();
        allow delete: if false;
      }

      match /worksheetReturns/{studentId} {
        allow get: if canManageRoom(roomId) || (isAuthenticated() && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)).data.mockAuthUid == request.auth.uid);
        allow list: if canManageRoom(roomId);
        allow create, update: if canManageRoom(roomId) && request.resource.data.keys().hasOnly(['worksheetIds']) && request.resource.data.worksheetIds is list;
        allow delete: if false;
      }
      match /worksheets/{worksheetId} {
        allow get: if canManageRoom(roomId) || (isAuthenticated()
          && get(/databases/$(database)/documents/rooms/$(roomId)/worksheetState/current).data.worksheetId == worksheetId) || (isAuthenticated() && request.auth.uid in resource.data.get('returnedUids', []));
        allow list: if canManageRoom(roomId);
        allow create: if canManageRoom(roomId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'FINISHED'
          && request.resource.data.keys().hasOnly(['id','roomId','title','html','questions','questionIds','fileName','status','createdAt','kind','groups','groupAccess','durationMinutes','deadlineAt'])
          && request.resource.data.get('kind', 'WORD') in ['WORD','BOARD','EXIT','GROUP']
          && (!('durationMinutes' in request.resource.data) || (request.resource.data.get('kind','WORD') == 'GROUP' && request.resource.data.durationMinutes is int && request.resource.data.durationMinutes >= 0 && request.resource.data.durationMinutes <= 60))
          && (!('deadlineAt' in request.resource.data) || (request.resource.data.get('kind','WORD') == 'GROUP' && request.resource.data.deadlineAt is int && request.resource.data.deadlineAt > request.time.toMillis() && request.resource.data.deadlineAt <= request.time.toMillis() + 3660000))
          && request.resource.data.id == worksheetId && request.resource.data.roomId == roomId
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.html is string && request.resource.data.html.size() <= 450000
          && request.resource.data.questions is list && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 40
          && request.resource.data.questionIds is list && request.resource.data.questionIds.size() == request.resource.data.questions.size()
          && request.resource.data.questionIds.toSet().size() == request.resource.data.questionIds.size()
          && (request.resource.data.get('kind','WORD') != 'BOARD' || request.resource.data.questionIds == ['answer-1'])
          && (request.resource.data.get('kind','WORD') != 'GROUP' || (request.resource.data.questionIds == ['answer-1'] && request.resource.data.groups is list && request.resource.data.groups.size() > 0 && request.resource.data.groups.size() <= 10 && request.resource.data.groupAccess is map && request.resource.data.groupAccess.size() > 0 && request.resource.data.groupAccess.size() <= 60))
          && (request.resource.data.get('kind','WORD') != 'EXIT' || request.resource.data.questionIds == ['answer-1','answer-2','answer-3'])
          && request.resource.data.status == 'OPEN' && request.resource.data.createdAt is string && request.resource.data.fileName is string;
        allow update: if canManageRoom(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','returnedUids'])
          && request.resource.data.status in ['OPEN','CLOSED']
          && (resource.data.status != 'CLOSED' || request.resource.data.status == 'CLOSED')
          && request.resource.data.get('returnedUids', []) is list;
        allow delete: if false;

        function canReadGroupResponse(studentId) {
          let sheet = get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data;
          let access = sheet.get('groupAccess', {}).get(request.auth.uid, {});
          return isAuthenticated() && sheet.get('kind','WORD') == 'GROUP'
            && access.get('leaderId','') == studentId && access.get('studentId','') != ''
            && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(access.studentId)).data.mockAuthUid == request.auth.uid;
        }
        function validReview(studentId) {
          let r = request.resource.data;
          return r.keys().hasOnly(['comment','score','questionComments','updatedAt','returnedAt'])
            && r.comment is string && r.comment.size() <= 5000
            && (r.score == null || (r.score is number && r.score >= 0 && r.score <= 10))
            && r.questionComments is map
            && r.questionComments.keys().hasOnly(get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.questionIds)
            && r.updatedAt is string && (r.returnedAt == null || r.returnedAt is string)
            && exists(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)/responses/$(studentId));
        }
        match /reviews/{studentId} {
          allow read: if canManageRoom(roomId);
          allow create, update: if canManageRoom(roomId) && validReview(studentId);
          allow delete: if false;
        }
        match /feedback/{studentId} {
          allow get: if canManageRoom(roomId) || (isAuthenticated() && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)).data.mockAuthUid == request.auth.uid) || canReadGroupResponse(studentId);
          allow list: if canManageRoom(roomId);
          allow create, update: if canManageRoom(roomId) && validReview(studentId) && request.resource.data.returnedAt is string;
          allow delete: if false;
        }
        match /responses/{studentId} {
          function ownsWorksheetResponse() {
            return isAuthenticated() && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)).data.mockAuthUid == request.auth.uid;
          }
          allow get: if canManageRoom(roomId) || ownsWorksheetResponse() || canReadGroupResponse(studentId);
          allow list: if canManageRoom(roomId);
          allow create: if ownsWorksheetResponse()
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'FINISHED'
            && get(/databases/$(database)/documents/rooms/$(roomId)/worksheetState/current).data.worksheetId == worksheetId
            && get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.status == 'OPEN'
            && (!('deadlineAt' in get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data) || request.time.toMillis() < get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.deadlineAt)
            && request.resource.data.keys().hasOnly(['studentId','studentName','authUid','answers','submittedAt'])
            && request.resource.data.studentId == studentId && request.resource.data.authUid == request.auth.uid
            && request.resource.data.studentName == get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)).data.name
            && request.resource.data.answers is map
            && request.resource.data.answers.keys().hasOnly(get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.questionIds)
            && request.resource.data.answers.keys().hasAll(get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.questionIds)
            && (get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.get('kind','WORD') != 'BOARD' || (request.resource.data.answers['answer-1'] is string && request.resource.data.answers['answer-1'].size() > 0 && request.resource.data.answers['answer-1'].size() <= 10000))
            && (get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.get('kind','WORD') != 'EXIT' || (request.resource.data.answers['answer-1'] is string && request.resource.data.answers['answer-1'].size() > 0 && request.resource.data.answers['answer-1'].size() <= 10000 && request.resource.data.answers['answer-2'] is string && request.resource.data.answers['answer-2'].size() > 0 && request.resource.data.answers['answer-2'].size() <= 10000 && request.resource.data.answers['answer-3'] in ['Em đã hiểu bài','Em còn phân vân','Em cần thầy/cô giúp']))
            && (get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.get('kind','WORD') != 'GROUP' || (get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.groupAccess[request.auth.uid].studentId == studentId && get(/databases/$(database)/documents/rooms/$(roomId)/worksheets/$(worksheetId)).data.groupAccess[request.auth.uid].leaderId == studentId && request.resource.data.answers['answer-1'] is string && request.resource.data.answers['answer-1'].size() > 0 && request.resource.data.answers['answer-1'].size() <= 10000))
            && request.resource.data.submittedAt is string;
          allow update, delete: if false;
        }
      }

      match /roster/{studentId} {
        allow read: if isAuthenticated();
        allow write: if canManageRoom(roomId);
      }

      match /participants/{studentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/roster/$(studentId))
          && request.resource.data.studentId == studentId
          && request.resource.data.mockAuthUid == request.auth.uid;
        allow update: if canManageRoom(roomId) || (
          isAuthenticated()
          && exists(/databases/$(database)/documents/rooms/$(roomId)/roster/$(studentId))
          && resource.data.mockAuthUid == request.auth.uid
          && request.resource.data.studentId == studentId
          && request.resource.data.mockAuthUid == request.auth.uid
        );
        allow delete: if canManageRoom(roomId);
      }

      match /liveQuestions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if canManageRoom(roomId);
      }

      function gameAllowsSubmission(questionId) {
        let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
        let game = room.get('activeGame', null);
        return room.get('status','ACTIVE') != 'FINISHED' && (game == null || (
          game.status != 'PAUSED' && (game.type != 'QUICK_ANSWER' || (
            game.get('roundQuestionId','') == questionId && (game.get('roundDeadlineAt',0) == 0 || request.time.toMillis() < game.roundDeadlineAt)
          ))
        ));
      }
      match /submissions/{submissionId} {
        allow read: if isTeacher() || (
          isAuthenticated()
          && resource.data.authUid == request.auth.uid
        );
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly(['questionId','studentId','studentName','authUid','answer','submittedAt'])
          && request.resource.data.answer is string && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 10000
          && submissionId == request.resource.data.questionId + '_' + request.resource.data.studentId
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.questionId is string
          && gameAllowsSubmission(request.resource.data.questionId)
          && request.resource.data.studentId is string
          && get(
            /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.studentId)
          ).data.mockAuthUid == request.auth.uid
          && request.resource.data.studentName == get(
            /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.studentId)
          ).data.name
          && get(
            /databases/$(database)/documents/rooms/$(roomId)/liveQuestions/$(request.resource.data.questionId)
          ).data.status == 'OPEN';
        allow update, delete: if canManageRoom(roomId);
      }

      match /scores/{studentId} {
        allow read: if canManageRoom(roomId) || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && get(
            /databases/$(database)/documents/rooms/$(roomId)/participants/$(studentId)
          ).data.mockAuthUid == request.auth.uid
        );
        allow write: if canManageRoom(roomId);
      }

      match /scoreEvents/{eventId} {
        allow read: if isTeacher();
        allow write: if canManageRoom(roomId);
      }

      match /summary/{summaryId} {
        allow read: if isTeacher();
        allow write: if canManageRoom(roomId);
      }

      match /games/{gameId} {
        allow read: if isAuthenticated();
        allow write: if canManageRoom(roomId);
      }
    }

    match /traditionMaterials/{materialId} {
      allow read: if resource.data.published == true || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.kind in ['HISTORY','CULTURE','IMAGE','VIDEO'];
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.published == true
        && request.resource.data.kind in ['HISTORY','CULTURE','IMAGE','VIDEO'];
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /traditionQuizzes/{quizId} {
      allow read: if resource.data.published == true || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.published == true && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 200;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.published == true && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 200;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Public learning copies, isolated from pupil identities and private assessment records.
    match /selfPracticeQuizzes/{quizId} {
      function validLearningCopy() {
        return request.resource.data.keys().hasOnly(['id','teacherId','title','grade','subject','questions','published','updatedAt','category','durationMinutes'])
          && request.resource.data.id == quizId
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.published == true
          && request.resource.data.get('category','PRACTICE') in ['PRACTICE','EXAM']
          && (!('durationMinutes' in request.resource.data) || (request.resource.data.durationMinutes is int && request.resource.data.durationMinutes >= 1 && request.resource.data.durationMinutes <= 180))
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.grade is string && request.resource.data.subject is string
          && request.resource.data.questions is list
          && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 200;
      }
      allow read: if resource.data.published == true || isOwner(resource.data.teacherId);
      allow create: if isTeacher() && validLearningCopy();
      allow update: if isOwner(resource.data.teacherId) && validLearningCopy()
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if isOwner(resource.data.teacherId);
    }

    // A high-entropy personal code reveals only its assigned pupil, never a class roster.
    match /selfPracticeAccess/{code} {
      function validAccess() {
        let a = request.resource.data;
        let student = get(/databases/$(database)/documents/classes/$(a.classId)/students/$(a.studentId)).data;
        let group = get(/databases/$(database)/documents/classes/$(a.classId)).data;
        return a.keys().hasOnly(['code','teacherId','classId','className','grade','studentId','studentName'])
          && code.matches('[A-HJ-NP-Z2-9]{12}') && a.code == code
          && a.teacherId == request.auth.uid && canManageClass(a.classId)
          && a.studentName == student.name && a.className == group.name && a.grade == group.grade;
      }
      allow get: if isAuthenticated();
      allow list: if isOwner(resource.data.teacherId);
      allow create: if isTeacher() && validAccess();
      allow update: if isOwner(resource.data.teacherId) && validAccess()
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isOwner(resource.data.teacherId);
    }

    match /selfPracticeWork/{workId} {
      function validStudentWork() {
        let w = request.resource.data;
        let a = get(/databases/$(database)/documents/selfPracticeAccess/$(w.accessCode)).data;
        let student = get(/databases/$(database)/documents/classes/$(a.classId)/students/$(a.studentId)).data;
        return w.keys().hasOnly(['id','teacherId','classId','className','studentId','studentName','quizId','quizTitle','subject','submittedAt','kind','result','outline','essay','accessCode','authUid'])
          && w.id == workId && w.authUid == request.auth.uid
          && w.teacherId == a.teacherId && w.classId == a.classId
          && w.studentId == a.studentId && w.studentName == a.studentName
          && w.studentName == student.name && w.className == a.className
          && w.quizId is string && w.quizTitle is string && w.subject is string && w.submittedAt is string
          && ((w.kind == 'QUIZ' && w.result is map && w.result.breakdown is list && w.result.breakdown.size() <= 200)
            || (w.kind == 'WRITING' && w.outline is list && w.outline.size() == 3 && w.essay is string && w.essay.size() > 0 && w.essay.size() <= 30000));
      }
      allow read: if isOwner(resource.data.teacherId);
      allow create: if isAuthenticated() && validStudentWork();
      // Permit idempotent delivery retries, but no edits to answers or identity.
      allow update: if isAuthenticated() && resource.data.authUid == request.auth.uid
        && validStudentWork() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedAt']);
      allow delete: if false;
    }

    match /testCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if code.matches('[0-9]{6}') && isTeacher()
        && (isSchoolAdmin() || request.resource.data.teacherId == request.auth.uid)
        && get(/databases/$(database)/documents/practiceSets/$(request.resource.data.testId)).data.type == 'TEST'
        && get(/databases/$(database)/documents/practiceSets/$(request.resource.data.testId)).data.teacherId == request.resource.data.teacherId;
      allow update: if false;
      allow delete: if isSchoolAdmin() || isOwner(resource.data.teacherId);
    }

    // 9. Self-Paced Practice Sets (practiceSets/{setId})
    match /practiceSets/{setId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update, delete: if isSchoolAdmin() || isOwner(resource.data.teacherId);

      match /studentProgress/{studentId} {
        allow read: if isTeacher() || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && (
            resource.data.authUid == null
            || resource.data.authUid == request.auth.uid
          )
        );
        allow create: if isTeacher();
        allow update: if isTeacher() || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && (
            resource.data.authUid == request.auth.uid
            || (
              resource.data.authUid == null
              && request.resource.data.authUid == request.auth.uid
            )
          )
        );
        allow delete: if isTeacher();
      }

      match /responses/{responseId} {
        allow read: if isTeacher() || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.authUid == request.auth.uid
        );
        allow create: if isAuthenticated()
          && request.resource.data.authUid == request.auth.uid;
        allow update: if isTeacher() || (
          isAuthenticated()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == request.auth.uid
        );
        allow delete: if isTeacher() || (
          isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.authUid == request.auth.uid
        );
      }
    }

    // 10. History Summaries (history/{historyId})
    match /history/{historyId} {
      allow read: if isSchoolAdmin() || isTeacher();
      allow write: if isTeacher();
    }

    // 11. Feedback
    match /pilotFeedback/{feedbackId} {
      allow read: if isSchoolAdmin();
      allow create: if isAuthenticated();
    }
  }
}
